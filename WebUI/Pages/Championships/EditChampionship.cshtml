@page "/championship/{championshipId}"
@model EditChampionshipModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using WebUI.Domain
@using WebUI.Pages.Championships
@{
    ViewData["Title"] = Model.Championship.Object.Name;
}
<h1>@Model.Championship.Object.Name</h1>
<form id="edit-championship" novalidate>
    <input type="hidden" name="championshipId" value="@Model.Championship.Object.ChampionshipId.ToBase36String()" />
    <input type="hidden" name="version" value="@Model.Championship.Version" />
    <formgroup>
        <label for="name">Name</label>
        <input name="name" value="@Model.Championship.Object.Name" />
    </formgroup>
    <button type="submit" id="submit-championship">Save</button>
</form>
<a asp-page="/Championships/ChampionshipsList">Back</a>

@section scripts {
    <script src="~/scripts/pages/championships/edit-championship.js" type="module"></script>
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<head>
    @if (ViewData.ContainsKey("Title"))
    {
        <title>@ViewData["Title"] - Formula Stamppot</title>
    }
    @RenderSection("head", required: false)
</head>
<body>
    @RenderBody()
    @RenderSection("scripts", required: false)
</body>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using Microsoft.AspNetCore.Components
@using WebUI.Pages.Shared
@inject IFileVersionProvider fileVersionProvider;
@{
    string versioned(string src)
        => fileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, src);

    var importMap = new ImportMapDefinition(new Dictionary<string, string>
    {
        { "system/navigation", versioned("/scripts/system/navigation.js")},
        { "api/formula-discord", versioned("/scripts/api/formula-discord.js")},
        { "form", versioned("/scripts/form.js")},
    }, null, null);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>@ViewData["Title"] - Formula Stamppot</title>
    <meta name="description" content="@ViewData["Description"]">
    <link rel="icon" href="~/favicon.ico">
    <meta name="theme-color" content="#ffffff">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <script type="importmap" asp-importmap="@importMap"></script>
    @RenderSection("head", required: false)
</head>
<body>
    <main route="@Context.Request.Path">
        @RenderBody()
    </main>
    <script src="~/scripts/app.js" type="module" asp-append-version="true"></script>
    @RenderSection("scripts", required: false)
</body>
</html>